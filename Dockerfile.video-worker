FROM node:26.12.1-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN npm install -g npm@12.0.1

# System packages for Chromium rendering, fonts fallback, ffmpeg audio/video mastering, and agy bootstrap
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    bash \
    git \
    ffmpeg \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libxshmfence1 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Install Antigravity headless CLI (agy) into /usr/local/bin for all users
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash && \
    cp /root/.local/bin/agy /usr/local/bin/agy && \
    chmod 755 /usr/local/bin/agy && \
    agy --version

WORKDIR /app

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

# Install app dependencies including hyperframes + tsx + playwright-core
# Note: package-lock.json currently has malformed empty @img/sharp optional entries that break npm ci;
# installing from package.json with --legacy-peer-deps succeeds cleanly on Debian bookworm.
COPY package.json ./
RUN mkdir -p /opt/ms-playwright && \
    npm install --legacy-peer-deps --no-audit --no-fund && \
    npm install --no-save hyperframes@0.8.181 tsx && \
    npx playwright-core install chromium

# Copy application source & worker assets
COPY tsconfig.json DESIGN.md ./
COPY src ./src
COPY video-worker ./video-worker

# Bake non-root execution user + ~/.gemini skills & critic agent for Cloud Run Job stability
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --create-home nextjs && \
    mkdir -p /home/nextjs/.gemini/agents /home/nextjs/.gemini/skills && \
    cp /app/video-worker/agents/gauntlet-critic.md /home/nextjs/.gemini/agents/gauntlet-critic.md && \
    HOME=/home/nextjs npx hyperframes skills update hyperframes hyperframes-cli hyperframes-registry media-use style-sampling --json </dev/null && \
    chmod -R a+rX /app && \
    chown -R nextjs:nodejs /opt/ms-playwright /home/nextjs /app/video-worker

USER nextjs

# Default Cloud Run Job environment for headless agy ADC & zero-npx PATH resolution
ENV AGY_ADC_AUTH=true \
    GOOGLE_CLOUD_LOCATION=global \
    PATH="/app/node_modules/.bin:${PATH}" \
    NODE_PATH="/app/node_modules" \
    NPM_CONFIG_CACHE="/tmp/.npm"

CMD ["tsx", "video-worker/entrypoint.ts"]

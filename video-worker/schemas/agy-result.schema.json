{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectDir",
    "mp4Path",
    "criticVerdict",
    "criticRounds",
    "criticNotes",
    "sourcesManifestPath"
  ],
  "properties": {
    "projectDir": {
      "type": "string",
      "minLength": 1
    },
    "mp4Path": {
      "type": "string",
      "minLength": 1
    },
    "criticVerdict": {
      "type": "string",
      "enum": ["OURS WINS", "NEEDS_REVIEW"]
    },
    "criticRounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "criticNotes": {
      "type": "string"
    },
    "sourcesManifestPath": {
      "type": "string",
      "minLength": 1
    }
  }
}

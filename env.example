# Google Cloud Firestore Configuration
GOOGLE_CLOUD_PROJECT_ID=your-project-id
FIRESTORE_DATABASE_ID=(default)

# For production, use service account credentials
# Download the service account key file and set the path here
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# For development, you can use Application Default Credentials (ADC)
# Run: gcloud auth application-default login
# This will automatically authenticate using your Google Cloud credentials

# Vertex AI / Gemini ingestion settings
GOOGLE_CLOUD_LOCATION=global
# LLM used for scoring, URL extraction, and summarisation during ingestion
INGEST_MODEL=gemini-3.5-flash-lite
# Embedding model (Vertex AI, location: global)
EMBEDDING_MODEL=gemini-embedding-2

# Optional: Reddit OAuth2 (client credentials) for reliable post fetching
# Create an app at https://www.reddit.com/prefs/apps (type: script)
# REDDIT_CLIENT_ID=your-client-id
# REDDIT_CLIENT_SECRET=your-client-secret

# Optional: Firecrawl fallback for JS-rendered pages
# FIRECRAWL_API_KEY=your-firecrawl-key

# Secret for the /api/cron/ingest endpoint (used by Cloud Scheduler in production)
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# Time-To-Live (TTL) configuration for Firestore documents
# Minimum: 3 (days), Default: 14 (days). Cleaned up automatically by GCP TTL.
TTL_DAYS=14

# Google Workspace / Gmail SMTP Configuration for Daily Email Digest
# SMTP_HOST=smtp-relay.gmail.com # or smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=your-google-app-password
# EMAIL_FROM="AI Daily Pulse <you@yourdomain.com>"
# DIGEST_RECIPIENTS="recipient1@example.com,recipient2@example.com"

# Admin Access Control (comma-separated email list)
# Restricts access to /admin and mutating admin APIs behind Cloud Run IAP
ADMIN_EMAILS=mblanc@google.com


